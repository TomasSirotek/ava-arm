<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ava_description</name>
  <version>1.0.0</version>
  <description>URDF/xacro model and meshes for the Ava 6-DOF arm (SO-101).</description>
  <maintainer email="72190589+TomasSirotek@users.noreply.github.com">Tomas Sirotek</maintainer>
  <author>Omar Draidrya (OmArm Zero)</author>
  <author>Aditya Kamath (so_arm_ros2)</author>
  <!-- MIT: OmArm Zero launch/config; Apache-2.0: SO-101 xacro (so_arm_ros2) + meshes (SO-ARM100). See ATTRIBUTION.md -->
  <license>MIT</license>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>xacro</depend>
  <depend>rviz2</depend>
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher</depend>
  <depend>joint_state_publisher_gui</depend>
  <depend>controller_manager</depend>
  <depend>ros2_control</depend>
  <depend>gz_ros2_control</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
