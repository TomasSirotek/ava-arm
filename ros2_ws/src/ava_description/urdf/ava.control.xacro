<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Real-hardware calibration for the PWM servos (ros2_control_hardware_type:=real only).
       Servos sit on a PCA9685 (I2C 0x40, 50 Hz) driven by an ESP32 over USB serial; the
       ava_hardware/AvaServoSystem plugin turns joint angles into pulse widths:
         us = round(zero_us + direction * q * servo_us_per_rad), clamped to [servo_min_us, servo_max_us]
       zero_us is derived in ava.ros2control.xacro from the per-joint centre pulse:
         zero_us = center_us - direction * (lower + upper) / 2 * servo_us_per_rad
       Hobby servos give NO feedback: the reported joint state is the last command sent. -->

  <!-- Pulse scale. UNCALIBRATED: assumes 500-2500 us sweeps 180 deg on every servo. Measure
       the real sweep of each servo and adjust (per-joint scales would go here). -->
  <xacro:property name="servo_us_per_rad" value="${2000 / pi}"/>
  <xacro:property name="servo_min_us" value="500"/>
  <xacro:property name="servo_max_us" value="2500"/>

  <!-- Serial link to the ESP32. The ESP32 resets when the port is opened, so the handshake
       waits for it to boot. On deactivation (Ctrl+C) the arm first moves smoothly to its rest
       pose in servo_park_duration_s (0 = no parking, max 4); then release_on_deactivate=true
       sends "D" (all servos limp), false keeps the rest pose held. -->
  <xacro:property name="servo_handshake_timeout_ms" value="4000"/>
  <xacro:property name="servo_release_on_deactivate" value="false"/>
  <xacro:property name="servo_park_duration_s" value="2.0"/>

  <!-- PCA9685 channel per joint (J-number = channel + 1). -->
  <xacro:property name="shoulder_pan_channel" value="0"/>   <!-- J1 MG996R -->
  <xacro:property name="shoulder_lift_channel" value="1"/>  <!-- J2 MG996R -->
  <xacro:property name="elbow_flex_channel" value="2"/>     <!-- J3 MG996R -->
  <xacro:property name="wrist_flex_channel" value="3"/>     <!-- J4 SG90 -->
  <xacro:property name="wrist_roll_channel" value="4"/>     <!-- J5 SG90 -->
  <xacro:property name="gripper_channel" value="5"/>        <!-- J6 SG90 -->

  <!-- Rotation sense: 1 if a larger pulse turns the joint towards +q, -1 otherwise.
       UNCALIBRATED: verify each joint on the bench and flip as needed. -->
  <xacro:property name="shoulder_pan_direction" value="1"/>
  <xacro:property name="shoulder_lift_direction" value="1"/>
  <xacro:property name="elbow_flex_direction" value="1"/>
  <xacro:property name="wrist_flex_direction" value="1"/>
  <xacro:property name="wrist_roll_direction" value="1"/>
  <xacro:property name="gripper_direction" value="1"/>

  <!-- Pulse (us) at the MIDDLE of each joint's range, (lower + upper) / 2. Assembly rule: mount
       each horn so the joint sits mid-range while the servo is centred at 1500 us; then trim
       these values on the bench to remove the spline offset. -->
  <xacro:property name="shoulder_pan_center_us" value="1500"/>
  <xacro:property name="shoulder_lift_center_us" value="1500"/>
  <xacro:property name="elbow_flex_center_us" value="1500"/>
  <xacro:property name="wrist_flex_center_us" value="1500"/>
  <xacro:property name="wrist_roll_center_us" value="1500"/>
  <xacro:property name="gripper_center_us" value="1500"/>

  <!-- Rate limit (rad/s) the plugin applies to every command step. No-load servo speeds:
       MG996R 0.13 s/60 deg @ 6 V (shop listing) = 8.06 rad/s;
       SG90 0.12 s/60 deg (datasheet) = 8.73 rad/s. Under load they are slower. -->
  <xacro:property name="shoulder_pan_max_velocity" value="8.06"/>   <!-- MG996R -->
  <xacro:property name="shoulder_lift_max_velocity" value="8.06"/>  <!-- MG996R -->
  <xacro:property name="elbow_flex_max_velocity" value="8.06"/>     <!-- MG996R -->
  <xacro:property name="wrist_flex_max_velocity" value="8.73"/>     <!-- SG90 -->
  <xacro:property name="wrist_roll_max_velocity" value="8.73"/>     <!-- SG90 -->
  <xacro:property name="gripper_max_velocity" value="8.73"/>        <!-- SG90 -->

  <!-- Rest pose (rad): the arm goes here on activation and parks here before shutdown. Set it to
       the pose the assembled arm sits in when unpowered, so start-up barely moves it. Must lie
       inside the joint limits below. 0 = the SRDF "home" pose. -->
  <xacro:property name="shoulder_pan_rest" value="0.0"/>
  <xacro:property name="shoulder_lift_rest" value="0.0"/>
  <xacro:property name="elbow_flex_rest" value="0.0"/>
  <xacro:property name="wrist_flex_rest" value="0.0"/>
  <xacro:property name="wrist_roll_rest" value="0.0"/>
  <xacro:property name="gripper_rest" value="0.0"/>

  <!-- Joint limits.
       GENERATED VALUES: these mirror the <limit> tags of the current CAD export
       (urdf/ava_robotic_arm.urdf). ava.kinematics.xacro references them by name so the
       numbers stay reviewable here rather than buried in the 45-link export. If you
       re-export the model with changed limits, update these to match. The effort
       ceilings further down are set from the servo layout, not copied from the export. -->
  <xacro:property name="shoulder_pan_lower" value="-1.570796"/>
  <xacro:property name="shoulder_pan_upper" value="1.570796"/>
  <xacro:property name="shoulder_lift_lower" value="-0.212536"/>
  <xacro:property name="shoulder_lift_upper" value="2.094395"/>
  <xacro:property name="elbow_flex_lower" value="-1.523672"/>
  <xacro:property name="elbow_flex_upper" value="1.617920"/>
  <xacro:property name="wrist_flex_lower" value="-2.617994"/>
  <xacro:property name="wrist_flex_upper" value="0.523599"/>
  <xacro:property name="wrist_roll_lower" value="-1.963495"/>
  <xacro:property name="wrist_roll_upper" value="1.178097"/>
  <xacro:property name="gripper_lower" value="-0.594434"/>
  <xacro:property name="gripper_upper" value="0.197952"/>

  <!-- Per-joint effort ceilings (N*m) = servo stall torque at the planned 6.0 V supply.
       MG996R (shoulder pan, shoulder lift, elbow): 11 kg*cm, TowerPro datasheet at 6 V. The
         plastic-gear MG996R being bought is listed at 15 kg*cm @ 6 V by the shop; 11 is kept
         until the real units are measured. Direct drive - there is no gearbox at any joint.
       SG90 / 9g micro (wrist flex, wrist roll, gripper): 1.6 kg*cm @ 6 V, from the datasheet of
         the servos in stock (dratek 897; 1.2 kg*cm @ 4.8 V).
       Each value sits just above the stall used by tools/torque_monitor.py, so a joint pinned
       at its limit in Gazebo reads as FAIL there.
       The elbow was moved to MG996R after the SG90 failed the Gazebo load test; the CAD
       export still shows an SG90 there until it is redrawn (TEMPORARY mass stub in
       ava.urdf.xacro). -->
  <xacro:property name="shoulder_pan_effort" value="1.079"/>   <!-- MG996R -->
  <xacro:property name="shoulder_lift_effort" value="1.079"/>  <!-- MG996R -->
  <xacro:property name="elbow_flex_effort" value="1.079"/>     <!-- MG996R -->
  <xacro:property name="wrist_flex_effort" value="0.157"/>      <!-- SG90 -->
  <xacro:property name="wrist_roll_effort" value="0.157"/>      <!-- SG90 -->
  <xacro:property name="gripper_effort" value="0.157"/>         <!-- SG90 -->

</robot>