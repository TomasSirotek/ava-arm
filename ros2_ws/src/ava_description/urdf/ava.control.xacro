<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Shared hardware interface parameters (single STS servo bus) -->
  <xacro:property name="serial_port" default="/dev/ttySERVO"/>
  <xacro:property name="baud_rate" default="1000000"/>
  <xacro:property name="use_mock" default="false"/>
  <xacro:property name="use_sync_write" default="true"/>

  <!-- Motor IDs -->
  <xacro:property name="shoulder_pan_motor_id" value="1"/>
  <xacro:property name="shoulder_lift_motor_id" value="2"/>
  <xacro:property name="elbow_flex_motor_id" value="3"/>
  <xacro:property name="wrist_flex_motor_id" value="4"/>
  <xacro:property name="wrist_roll_motor_id" value="5"/>
  <xacro:property name="gripper_motor_id" value="6"/>
  <xacro:property name="arm_operating_mode" value="0"/>     <!-- Arm joints 1-5: 0=Position, 1=Velocity, 2=PWM/Effort -->
  <xacro:property name="gripper_operating_mode" value="0"/> <!-- Gripper joint 6: 0=Position, 1=Velocity, 2=PWM/Effort -->

  <!-- Motor-specific, model-dependent parameter (written to every joint below so different
       STS models could share this bus) -->
  <xacro:property name="sts_protocol_max_vel_steps" value="65535"/>  <!-- protocol's own u16 ceiling - let servo firmware, not us, set the real cap -->

  <!-- Maximum allowable torque/velocity for each motor -->
  <xacro:property name="max_velocity_steps" value="${sts_protocol_max_vel_steps}"/>  <!-- full hardware max -->
  <xacro:property name="max_velocity_rads" value="${max_velocity_steps*2*pi/4096}"/>  <!-- rad/s -->
  <xacro:property name="max_torque_nm" value="2.942"/>  <!-- N⋅m (30 kgf⋅cm for STS3215) -->

  <!-- Position-mode (Mode 0) internal servo PID, written to EEPROM on activate -->
  <xacro:property name="shoulder_pan_p_coefficient" value="14"/>
  <xacro:property name="shoulder_pan_d_coefficient" value="24"/>
  <xacro:property name="shoulder_pan_i_coefficient" value="0"/>
  <xacro:property name="shoulder_lift_p_coefficient" value="14"/>
  <xacro:property name="shoulder_lift_d_coefficient" value="24"/>
  <xacro:property name="shoulder_lift_i_coefficient" value="0"/>
  <xacro:property name="elbow_flex_p_coefficient" value="14"/>
  <xacro:property name="elbow_flex_d_coefficient" value="24"/>
  <xacro:property name="elbow_flex_i_coefficient" value="0"/>
  <xacro:property name="wrist_flex_p_coefficient" value="14"/>
  <xacro:property name="wrist_flex_d_coefficient" value="24"/>
  <xacro:property name="wrist_flex_i_coefficient" value="0"/>
  <xacro:property name="wrist_roll_p_coefficient" value="14"/>
  <xacro:property name="wrist_roll_d_coefficient" value="24"/>
  <xacro:property name="wrist_roll_i_coefficient" value="0"/>
  <xacro:property name="gripper_p_coefficient" value="14"/>
  <xacro:property name="gripper_d_coefficient" value="24"/>
  <xacro:property name="gripper_i_coefficient" value="0"/>
  <!-- Position insensitive-area (CW_DEAD/CCW_DEAD, both set to this value) -->
  <xacro:property name="deadband" value="10"/>

  <!-- Joint limits and per-joint effort ceilings.
       GENERATED VALUES: these mirror the <limit> tags of the current CAD export
       (urdf/ava_robotic_arm.urdf). ava.kinematics.xacro references them by name so the
       numbers stay reviewable here rather than buried in the 45-link export. If you
       re-export the model with changed limits, update these to match. -->
  <xacro:property name="shoulder_pan_lower" value="-1.570796"/>
  <xacro:property name="shoulder_pan_upper" value="1.570796"/>
  <xacro:property name="shoulder_lift_lower" value="-0.212536"/>
  <xacro:property name="shoulder_lift_upper" value="2.094395"/>
  <xacro:property name="elbow_flex_lower" value="-1.523672"/>
  <xacro:property name="elbow_flex_upper" value="1.617920"/>
  <xacro:property name="wrist_flex_lower" value="-2.617994"/>
  <xacro:property name="wrist_flex_upper" value="0.523599"/>
  <xacro:property name="wrist_roll_lower" value="-1.963495"/>
  <xacro:property name="wrist_roll_upper" value="1.178097"/>
  <xacro:property name="gripper_lower" value="-0.594434"/>
  <xacro:property name="gripper_upper" value="0.197952"/>

  <!-- Per-joint effort ceilings (N*m). The redesign is no longer a uniform STS3215 bus:
       the CAD model is built around MG996R servos at the shoulder and SG90s from the
       elbow out, so effort now differs per joint instead of sharing max_torque_nm.
       NOTE: ava.ros2control.xacro still drives this arm as an STS3215 serial bus
       (motor IDs, EEPROM PID writes). That hardware layer has not been retargeted. -->
  <xacro:property name="shoulder_pan_effort" value="1.079"/>   <!-- MG996R -->
  <xacro:property name="shoulder_lift_effort" value="2.157"/>  <!-- MG996R, geared -->
  <xacro:property name="elbow_flex_effort" value="0.177"/>     <!-- SG90 -->
  <xacro:property name="wrist_flex_effort" value="0.177"/>      <!-- SG90 -->
  <xacro:property name="wrist_roll_effort" value="0.177"/>      <!-- SG90 -->
  <xacro:property name="gripper_effort" value="0.177"/>         <!-- SG90 -->

</robot>