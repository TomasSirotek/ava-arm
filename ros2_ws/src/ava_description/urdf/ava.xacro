    <origin xyz="0.11054 0.029602 -0.225319" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ava_description)/meshes/gripper_right_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.11054 0.029602 -0.225319" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ava_description)/meshes/gripper_right_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
