    <inertia ixx="7.3e-05" iyy="8.2e-05" izz="8.7e-05" ixy="-8e-06" iyz="1.3e-05" ixz="1.7e-05"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 0.0 -0.05087" rpy="0 0 0"/>
