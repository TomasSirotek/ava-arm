<joint name="Revolute 1" type="revolute">
  <origin xyz="0.0 0.0 0.05087" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="base_link_upper_1"/>
  <axis xyz="0.0 0.0 1.0"/>
  <dynamics damping="2.0" friction="0.02"/>
  <limit lower="0.0" upper="3.14" effort="40.0" velocity="0.2"/>
</joint>

<joint name="Revolute 2" type="revolute">
  <origin xyz="-0.023144 0.000378 0.039352" rpy="0 3.14 0"/>
  <parent link="base_link_upper_1"/>
  <child link="arm_link_1_1"/>
  <axis xyz="0.016327 0.999867 0.0"/>
  <dynamics damping="2.0" friction="0.02"/>
  <limit lower="-3.14" upper="0.0" effort="40.0" velocity="0.2"/>
</joint>

<joint name="Revolute 3" type="revolute">
  <origin xyz="-0.113109 0.001847 0.000246" rpy="0 3.14 0"/>
  <parent link="arm_link_1_1"/>
  <child link="arm_link_2_1"/>
  <axis xyz="-0.016327 -0.999867 0.0"/>
  <dynamics damping="2.0" friction="0.02"/>
  <limit lower="-3.14" upper="0.0" effort="40.0" velocity="0.2"/>
</joint>

<joint name="Revolute 4" type="revolute">
  <origin xyz="0.000462 -0.015261 0.097047" rpy="0 0 3.14"/>
  <parent link="arm_link_2_1"/>
  <child link="arm_link_3_1"/>
  <axis xyz="0.007329 -0.000135 0.999973"/>
  <dynamics damping="1.5" friction="0.02"/>
  <limit lower="-3.14" upper="0.0" effort="35.0" velocity="0.2"/>
</joint>

<joint name="Revolute 5" type="revolute">
  <origin xyz="0.000194 -0.015254 0.028247" rpy="0 3.14 0"/>
  <parent link="arm_link_3_1"/>
  <child link="gripper_base_1"/>
  <axis xyz="-0.000888 -1.0 -0.000129"/>
  <dynamics damping="1.5" friction="0.02"/>
  <limit lower="-3.14" upper="0.0" effort="30.0" velocity="0.2"/>
</joint>

<joint name="Revolute 6" type="revolute">
  <origin xyz="0.025083 0.026448 0.009211" rpy="0 0 0"/>
  <parent link="gripper_base_1"/>
  <child link="gripper_left_1"/>
  <axis xyz="0.002278 0.000127 -0.999997"/>
  <dynamics damping="1.0" friction="0.02"/>
  <!-- Full servo range: open = -1.57 (servo 180deg), closed = +1.57 (servo 0deg),
       full speed (user directive: gripper is ONE servo, no interpolation fuss). -->
  <limit lower="-1.6" upper="1.6" effort="10.0" velocity="4.0"/>
</joint>

<joint name="Revolute 7" type="revolute">
  <origin xyz="0.025057 -0.001312 0.009557" rpy="0 0 0"/>
  <parent link="gripper_base_1"/>
  <child link="gripper_right_1"/>
  <axis xyz="-0.002278 -0.000127 0.999997"/>
  <dynamics damping="1.0" friction="0.02"/>
  <limit lower="-1.6" upper="1.6" effort="10.0" velocity="4.0"/>
</joint>

<ros2_control name="GazeboSystem" type="system">
  <hardware>
    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
  </hardware>

  <joint name="Revolute 1">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>

  <joint name="Revolute 2">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>

  <joint name="Revolute 3">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>

  <joint name="Revolute 4">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>

  <joint name="Revolute 5">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>

  <joint name="Revolute 6">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>

  <joint name="Revolute 7">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
</ros2_control>

<!-- TCP / grasp frame: midpoint between the gripper fingertips, ~9 cm along the
     gripper's +X (finger-extension) axis from gripper_base_1. Pure frame (no
     visual/collision). Pick code targets THIS link's position so the 9 cm
     gripper offset is handled by FK regardless of the (position-only IK) wrist
     orientation. Tune xyz if the real fingertip differs. -->
<link name="tcp"/>
<joint name="gripper_base_to_tcp" type="fixed">
  <!-- Frame 'tcp' at the fingertip region: translate +9 cm along gb1-X (finger
       extension) + 1.5 cm along gb1-Y, THEN rotate rpy(0, pi/2, 0) so tcp +Z == gb1-X
       == the finger/APPROACH axis (the axis that CAN stand vertical; the gb1-Z hinge
       axis never can). The IK places this tcp origin at the marker-0 position and puts
       tcp +Z straight down = ON the marker-0 Z axis -> clean vertical top-down grasp;
       rotation about that axis is free. Origin (approached position) is unchanged. -->
  <origin xyz="0.09 0.015 0.0" rpy="0 1.5708 0"/>
  <parent link="gripper_base_1"/>
  <child link="tcp"/>
</joint>

</robot>
