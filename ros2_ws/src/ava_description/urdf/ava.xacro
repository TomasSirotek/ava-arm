<?xml version="1.0" ?>
<robot name="ava" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find ava_description)/urdf/materials.xacro" />
<xacro:include filename="$(find ava_description)/urdf/ava.gazebo" />

<link name="world"/>

<joint name="world_to_base" type="fixed">
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <parent link="world"/>
  <child link="base_link"/>
</joint>

<link name="base_link">
  <inertial>
    <origin xyz="-0.0008862089688185305 0.019817228665032917 0.028036352675664372" rpy="0 0 0"/>
    <mass value="0.2095325128799142"/>
    <inertia ixx="0.000388" iyy="0.000273" izz="0.000577" ixy="1.2e-05" iyz="-1.5e-05" ixz="2e-06"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ava_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ava_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="base_link_upper_1">
