<?xml version="1.0"?>
<!-- Shared properties for the Ava arm.

     Joint origins used to live here; they now come from the CAD export via
     ava.kinematics.xacro, so only the frames the exporter does not model are left. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Color properties (RGBA) -->
  <xacro:property name="light_grey_rgba" value="0.8 0.8 0.8 1.0"/>
  <xacro:property name="charcoal_rgba" value="0.15 0.15 0.15 1.0"/>

  <!-- Height of base_link's underside above base_footprint, after the Z-down export is
       flipped pi about X (see world_to_base in ava.urdf.xacro). Measured from the
       base_link collision mesh: it spans z=-0.0843..+0.0337 once flipped. -->
  <xacro:property name="base_mount_z" value="0.0337"/>

  <!-- Tool frame, in the gripper_base_link frame. Measured from the gripper meshes:
       the jaws span x=-0.0676..-0.002 and the body reaches x=-0.0705, so the grasp point
       sits just inside the jaw tips. end_effector_link's rpy yaws pi so its axes read
       X=approach Y=left Z=up like ik_target, instead of the CAD part orientation. -->
  <xacro:property name="end_effector_xyz" value="-0.065 0.003 -0.025"/>
  <xacro:property name="end_effector_rpy" value="0 0 3.141593"/>

  <!-- Wrist camera: PLACEHOLDER extrinsics. The redesign has no camera mount part, so
       there is nothing in the CAD model to measure these against. The frames exist only
       so ava_vision's TF lookups resolve; re-measure on hardware before relying on them.
       See the wrist_camera_urdf arg in ava.urdf.xacro to omit them entirely. -->
  <xacro:property name="wrist_camera_mount_xyz" value="0 0 0"/>
  <xacro:property name="wrist_camera_mount_rpy" value="0 0 0"/>
  <xacro:property name="wrist_camera_frame_xyz" value="0 0 0"/>
  <xacro:property name="wrist_camera_frame_rpy" value="0 0 0"/>

  <!-- REP-103 optical frame (+Z forward, +X right, +Y down) as child of wrist_camera_frame. -->
  <xacro:property name="wrist_camera_optical_rpy" value="-1.5708 0 -1.5708"/>

</robot>
