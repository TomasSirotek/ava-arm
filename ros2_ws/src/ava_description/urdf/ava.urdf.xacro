<?xml version="1.0"?>
<robot name="ava" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find ava_description)/urdf/ava.common.xacro"/>
  <xacro:include filename="$(find ava_description)/urdf/ava.control.xacro"/>

  <!-- Arguments (externally settable, default to property values in ava.control.xacro) -->
  <xacro:arg name="serial_port"    default="${serial_port}"/>
  <xacro:arg name="baud_rate"      default="${baud_rate}"/>
  <xacro:arg name="use_mock"       default="${use_mock}"/>
  <xacro:arg name="use_sync_write" default="${use_sync_write}"/>
  <xacro:arg name="arm_operating_mode"     default="${arm_operating_mode}"/>     <!-- 0=Position 1=Velocity 2=PWM; arm joints 1-5; baked at startup -->
  <xacro:arg name="gripper_operating_mode" default="${gripper_operating_mode}"/> <!-- 0=Position 1=Velocity 2=PWM; gripper joint 6; baked at startup -->
  <xacro:arg name="shoulder_pan_motor_id" default="${shoulder_pan_motor_id}"/>
  <xacro:arg name="shoulder_lift_motor_id" default="${shoulder_lift_motor_id}"/>
  <xacro:arg name="elbow_flex_motor_id" default="${elbow_flex_motor_id}"/>
  <xacro:arg name="wrist_flex_motor_id" default="${wrist_flex_motor_id}"/>
  <xacro:arg name="wrist_roll_motor_id" default="${wrist_roll_motor_id}"/>
  <xacro:arg name="gripper_motor_id" default="${gripper_motor_id}"/>
  <xacro:arg name="shoulder_pan_p_coefficient" default="${shoulder_pan_p_coefficient}"/>
  <xacro:arg name="shoulder_pan_d_coefficient" default="${shoulder_pan_d_coefficient}"/>
  <xacro:arg name="shoulder_pan_i_coefficient" default="${shoulder_pan_i_coefficient}"/>
  <xacro:arg name="shoulder_lift_p_coefficient" default="${shoulder_lift_p_coefficient}"/>
  <xacro:arg name="shoulder_lift_d_coefficient" default="${shoulder_lift_d_coefficient}"/>
  <xacro:arg name="shoulder_lift_i_coefficient" default="${shoulder_lift_i_coefficient}"/>
  <xacro:arg name="elbow_flex_p_coefficient" default="${elbow_flex_p_coefficient}"/>
  <xacro:arg name="elbow_flex_d_coefficient" default="${elbow_flex_d_coefficient}"/>
  <xacro:arg name="elbow_flex_i_coefficient" default="${elbow_flex_i_coefficient}"/>
  <xacro:arg name="wrist_flex_p_coefficient" default="${wrist_flex_p_coefficient}"/>
  <xacro:arg name="wrist_flex_d_coefficient" default="${wrist_flex_d_coefficient}"/>
  <xacro:arg name="wrist_flex_i_coefficient" default="${wrist_flex_i_coefficient}"/>
  <xacro:arg name="wrist_roll_p_coefficient" default="${wrist_roll_p_coefficient}"/>
  <xacro:arg name="wrist_roll_d_coefficient" default="${wrist_roll_d_coefficient}"/>
  <xacro:arg name="wrist_roll_i_coefficient" default="${wrist_roll_i_coefficient}"/>
  <xacro:arg name="gripper_p_coefficient" default="${gripper_p_coefficient}"/>
  <xacro:arg name="gripper_d_coefficient" default="${gripper_d_coefficient}"/>
  <xacro:arg name="gripper_i_coefficient" default="${gripper_i_coefficient}"/>
  <xacro:arg name="deadband" default="${deadband}"/>

  <!-- real=STS serial plugin, gazebo=gz_ros2_control, mujoco=MujocoSystemInterface,
       mock_components=GenericSystem. Selects the <hardware> block in ava.ros2control.xacro. -->
  <xacro:arg name="ros2_control_hardware_type" default="real"/>
  <!-- mujoco only -->
  <xacro:arg name="mujoco_model" default=""/>
  <xacro:arg name="mujoco_headless" default="false"/>
  <!-- false = omit the wrist camera mount/body/frame links and their fixed joints below -->
  <xacro:arg name="wrist_camera_urdf" default="true"/>
  <!-- Load testing: a point mass at the tool frame (e.g. an object held by the gripper).
       0 = no payload. Set from gazebo.launch.py payload_kg:=0.1 -->
  <xacro:arg name="payload_kg" default="0"/>

  <material name="light_grey">
    <color rgba="${light_grey_rgba}"/>
  </material>
  <material name="charcoal">
    <color rgba="${charcoal_rgba}"/>
  </material>

  <!-- KINEMATICS: all 45 links and 44 joints of the CAD export, generated by
       scripts/generate_kinematics_xacro.py. Everything below that include is structure
       the exporter does not know about. -->
  <xacro:include filename="$(find ava_description)/urdf/ava.kinematics.xacro"/>

  <!-- Dummy root link (KDL does not support inertia on root link, and the export's
       base_link carries the bulk of the robot's mass).

       This joint also carries the frame correction for the CAD export, which is authored
       Z-DOWN: in base_link the chassis spans z=-0.084..+0.034 and the arm stacks into -Z,
       so without the rpy below the whole robot hangs underneath the ground plane. Rotating
       pi about X puts it in REP-103 (Z up); the z offset then rests the base's underside
       on base_footprint's z=0. Measured from the base_link mesh - if the base plate
       changes in CAD, re-measure (${base_mount_z} in ava.common.xacro). -->
  <link name="base_footprint"/>
  <joint name="world_to_base" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_mount_z}" rpy="${pi} 0 0"/>
  </joint>

  <!-- TOOL FRAME: the grasp point between the jaws. Derived from the gripper meshes in
       the gripper_base_link frame (the jaws reach x=-0.0705, so the grasp point sits just
       inside the tip). rpy yaws pi so the frame reads X=approach Y=left Z=up like
       ik_target, rather than the CAD part orientation. Verify against hardware before
       trusting it for fine placement. -->
  <link name="end_effector_link"/>
  <joint name="end_effector_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="end_effector_link"/>
    <origin xyz="${end_effector_xyz}" rpy="${end_effector_rpy}"/>
  </joint>

  <xacro:if value="${float('$(arg payload_kg)') > 0}">
    <link name="payload_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="$(arg payload_kg)"/>
        <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <geometry><sphere radius="0.015"/></geometry>
        <material name="charcoal"/>
      </visual>
    </link>
    <joint name="payload_joint" type="fixed">
      <parent link="end_effector_link"/>
      <child link="payload_link"/>
    </joint>
  </xacro:if>

  <!-- WRIST CAMERA: frames only. The redesign has no camera mount part, so the SO-101
       mount and camera-body meshes are gone and these poses are PLACEHOLDERS - the frames
       exist so ava_vision's TF lookups still resolve, but the extrinsics are NOT
       calibrated for this arm. Re-measure (or pass wrist_camera_urdf:=false) before using
       camera-frame coordinates for picking. -->
  <xacro:if value="${'$(arg wrist_camera_urdf)' == 'true'}">
    <link name="wrist_camera_mount_link"/>
    <link name="wrist_camera_frame"/>
    <link name="wrist_camera_optical_frame"/>

    <joint name="wrist_camera_mount_joint" type="fixed">
      <parent link="gripper_base_link"/>
      <child link="wrist_camera_mount_link"/>
      <origin xyz="${wrist_camera_mount_xyz}" rpy="${wrist_camera_mount_rpy}"/>
    </joint>

    <joint name="wrist_camera_frame_joint" type="fixed">
      <parent link="wrist_camera_mount_link"/>
      <child link="wrist_camera_frame"/>
      <origin xyz="${wrist_camera_frame_xyz}" rpy="${wrist_camera_frame_rpy}"/>
    </joint>

    <!-- REP-103 optical frame (+Z forward, +X right, +Y down) -->
    <joint name="wrist_camera_optical_joint" type="fixed">
      <parent link="wrist_camera_frame"/>
      <child link="wrist_camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="${wrist_camera_optical_rpy}"/>
    </joint>
  </xacro:if>

  <!-- ROS 2 CONTROL: the only part that differs between sim and real -->
  <xacro:include filename="$(find ava_description)/urdf/ava.ros2control.xacro"/>

  <!-- GAZEBO: plugin that loads ros2_control inside gz sim (gazebo only) -->
  <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gazebo'}">
    <xacro:include filename="$(find ava_description)/urdf/ava.gazebo.xacro"/>
  </xacro:if>

</robot>