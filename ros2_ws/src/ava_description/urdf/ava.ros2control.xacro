      <param name="max_velocity">${max_velocity_rads}</param>
      <param name="position_center_steps">2048</param>
      <param name="p_coefficient">$(arg gripper_p_coefficient)</param>
      <param name="d_coefficient">$(arg gripper_d_coefficient)</param>
      <param name="i_coefficient">$(arg gripper_i_coefficient)</param>
      <param name="deadband">$(arg deadband)</param>
      <!-- Undocumented STS3215 EEPROM tuning registers (community-discovered). Uncomment to enable;
           internal_max_vel/internal_max_acc/internal_acc_coeff: [0,254], internal_control_period: [1,254].
      <param name="internal_max_vel">65</param>
      <param name="internal_max_acc">254</param>
      <param name="internal_acc_coeff">0</param>
      <param name="internal_control_period">20</param>
      -->
      <!-- cmd interfaces depend on gripper_operating_mode -->
      <xacro:if value="${'$(arg gripper_operating_mode)' == '2'}">
        <command_interface name="effort"/>
      </xacro:if>
      <xacro:unless value="${'$(arg gripper_operating_mode)' == '2'}">
