<?xml version="1.0"?>
<!-- ros2_control block for the Ava arm.
     This is the ONLY file that changes between sim and real hardware: the
     ros2_control_hardware_type arg (declared in ava.urdf.xacro) picks the <hardware>
     plugin. Joints, limits and interfaces are identical for every backend.
     Included by ava.urdf.xacro - not a standalone robot. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ROS 2 CONTROL -->
  <ros2_control name="ava_control" type="system">
    <hardware>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mujoco'}">
        <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
        <param name="mujoco_model">$(arg mujoco_model)</param>
        <param name="headless">$(arg mujoco_headless)</param>
      </xacro:if>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gazebo'}">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mock_components'}">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
        <plugin>sts_hardware_interface/STSHardwareInterface</plugin>
        <param name="serial_port">$(arg serial_port)</param>
        <param name="baud_rate">$(arg baud_rate)</param>
        <param name="communication_timeout_ms">100</param>
        <param name="use_sync_write">$(arg use_sync_write)</param>
        <param name="enable_mock_mode">$(arg use_mock)</param>
        <param name="reset_states_on_activate">true</param>
      </xacro:if>
    </hardware>

    <joint name="shoulder_pan">
      <param name="motor_id">$(arg shoulder_pan_motor_id)</param>
      <param name="operating_mode">$(arg arm_operating_mode)</param>
      <param name="min_position">${shoulder_pan_lower}</param>
      <param name="max_position">${shoulder_pan_upper}</param>
      <!-- Motor-specific, model-dependent parameter (per joint so different STS models can share this bus) -->
      <param name="max_velocity_steps">${sts_protocol_max_vel_steps}</param>
      <param name="max_velocity">${max_velocity_rads}</param>
      <param name="position_center_steps">2048</param>
      <param name="p_coefficient">$(arg shoulder_pan_p_coefficient)</param>
      <param name="d_coefficient">$(arg shoulder_pan_d_coefficient)</param>
      <param name="i_coefficient">$(arg shoulder_pan_i_coefficient)</param>
      <param name="deadband">$(arg deadband)</param>
      <!-- Undocumented STS3215 EEPROM tuning registers (community-discovered). Uncomment to enable;
           internal_max_vel/internal_max_acc/internal_acc_coeff: [0,254], internal_control_period: [1,254].
      <param name="internal_max_vel">65</param>
      <param name="internal_max_acc">254</param>
      <param name="internal_acc_coeff">0</param>
      <param name="internal_control_period">20</param>
      -->
      <!-- cmd interfaces depend on arm_operating_mode -->
      <xacro:if value="${'$(arg arm_operating_mode)' == '2'}">
        <command_interface name="effort"/>
      </xacro:if>
      <xacro:unless value="${'$(arg arm_operating_mode)' == '2'}">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
      </xacro:unless>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- real hardware only -->
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
        <state_interface name="voltage"/>
        <state_interface name="temperature"/>
        <state_interface name="current"/>
        <state_interface name="is_moving"/>
      </xacro:if>
    </joint>

    <joint name="shoulder_lift">
      <param name="motor_id">$(arg shoulder_lift_motor_id)</param>
      <param name="operating_mode">$(arg arm_operating_mode)</param>
      <param name="min_position">${shoulder_lift_lower}</param>
      <param name="max_position">${shoulder_lift_upper}</param>
      <!-- Motor-specific, model-dependent parameter (per joint so different STS models can share this bus) -->
      <param name="max_velocity_steps">${sts_protocol_max_vel_steps}</param>
      <param name="max_velocity">${max_velocity_rads}</param>
      <param name="position_center_steps">2048</param>
      <param name="p_coefficient">$(arg shoulder_lift_p_coefficient)</param>
      <param name="d_coefficient">$(arg shoulder_lift_d_coefficient)</param>
      <param name="i_coefficient">$(arg shoulder_lift_i_coefficient)</param>
      <param name="deadband">$(arg deadband)</param>
      <!-- Undocumented STS3215 EEPROM tuning registers (community-discovered). Uncomment to enable;
           internal_max_vel/internal_max_acc/internal_acc_coeff: [0,254], internal_control_period: [1,254].
      <param name="internal_max_vel">65</param>
      <param name="internal_max_acc">254</param>
      <param name="internal_acc_coeff">0</param>
      <param name="internal_control_period">20</param>
      -->
      <!-- cmd interfaces depend on arm_operating_mode -->
      <xacro:if value="${'$(arg arm_operating_mode)' == '2'}">
        <command_interface name="effort"/>
      </xacro:if>
      <xacro:unless value="${'$(arg arm_operating_mode)' == '2'}">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
      </xacro:unless>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- real hardware only -->
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
        <state_interface name="voltage"/>
        <state_interface name="temperature"/>
        <state_interface name="current"/>
        <state_interface name="is_moving"/>
      </xacro:if>
    </joint>

    <joint name="elbow_flex">
      <param name="motor_id">$(arg elbow_flex_motor_id)</param>
      <param name="operating_mode">$(arg arm_operating_mode)</param>
      <param name="min_position">${elbow_flex_lower}</param>
      <param name="max_position">${elbow_flex_upper}</param>
      <!-- Motor-specific, model-dependent parameter (per joint so different STS models can share this bus) -->
      <param name="max_velocity_steps">${sts_protocol_max_vel_steps}</param>
      <param name="max_velocity">${max_velocity_rads}</param>
      <param name="position_center_steps">2048</param>
      <param name="p_coefficient">$(arg elbow_flex_p_coefficient)</param>
      <param name="d_coefficient">$(arg elbow_flex_d_coefficient)</param>
      <param name="i_coefficient">$(arg elbow_flex_i_coefficient)</param>
      <param name="deadband">$(arg deadband)</param>
      <!-- Undocumented STS3215 EEPROM tuning registers (community-discovered). Uncomment to enable;
           internal_max_vel/internal_max_acc/internal_acc_coeff: [0,254], internal_control_period: [1,254].
      <param name="internal_max_vel">65</param>
      <param name="internal_max_acc">254</param>
      <param name="internal_acc_coeff">0</param>
      <param name="internal_control_period">20</param>
      -->
      <!-- cmd interfaces depend on arm_operating_mode -->
      <xacro:if value="${'$(arg arm_operating_mode)' == '2'}">
        <command_interface name="effort"/>
      </xacro:if>
      <xacro:unless value="${'$(arg arm_operating_mode)' == '2'}">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
      </xacro:unless>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- real hardware only -->
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
        <state_interface name="voltage"/>
        <state_interface name="temperature"/>
        <state_interface name="current"/>
        <state_interface name="is_moving"/>
      </xacro:if>
    </joint>

    <joint name="wrist_flex">
      <param name="motor_id">$(arg wrist_flex_motor_id)</param>
      <param name="operating_mode">$(arg arm_operating_mode)</param>
      <param name="min_position">${wrist_flex_lower}</param>
      <param name="max_position">${wrist_flex_upper}</param>
      <!-- Motor-specific, model-dependent parameter (per joint so different STS models can share this bus) -->
      <param name="max_velocity_steps">${sts_protocol_max_vel_steps}</param>
      <param name="max_velocity">${max_velocity_rads}</param>
      <param name="position_center_steps">2048</param>
      <param name="p_coefficient">$(arg wrist_flex_p_coefficient)</param>
      <param name="d_coefficient">$(arg wrist_flex_d_coefficient)</param>
      <param name="i_coefficient">$(arg wrist_flex_i_coefficient)</param>
      <param name="deadband">$(arg deadband)</param>
      <!-- Undocumented STS3215 EEPROM tuning registers (community-discovered). Uncomment to enable;
           internal_max_vel/internal_max_acc/internal_acc_coeff: [0,254], internal_control_period: [1,254].
      <param name="internal_max_vel">65</param>
      <param name="internal_max_acc">254</param>
      <param name="internal_acc_coeff">0</param>
      <param name="internal_control_period">20</param>
      -->
      <!-- cmd interfaces depend on arm_operating_mode -->
      <xacro:if value="${'$(arg arm_operating_mode)' == '2'}">
        <command_interface name="effort"/>
      </xacro:if>
      <xacro:unless value="${'$(arg arm_operating_mode)' == '2'}">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
      </xacro:unless>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- real hardware only -->
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
        <state_interface name="voltage"/>
        <state_interface name="temperature"/>
        <state_interface name="current"/>
        <state_interface name="is_moving"/>
      </xacro:if>
    </joint>

    <joint name="wrist_roll">
      <param name="motor_id">$(arg wrist_roll_motor_id)</param>
      <param name="operating_mode">$(arg arm_operating_mode)</param>
      <param name="min_position">${wrist_roll_lower}</param>
      <param name="max_position">${wrist_roll_upper}</param>
      <!-- Motor-specific, model-dependent parameter (per joint so different STS models can share this bus) -->
      <param name="max_velocity_steps">${sts_protocol_max_vel_steps}</param>
      <param name="max_velocity">${max_velocity_rads}</param>
      <param name="position_center_steps">2048</param>
      <param name="p_coefficient">$(arg wrist_roll_p_coefficient)</param>
      <param name="d_coefficient">$(arg wrist_roll_d_coefficient)</param>
      <param name="i_coefficient">$(arg wrist_roll_i_coefficient)</param>
      <param name="deadband">$(arg deadband)</param>
      <!-- Undocumented STS3215 EEPROM tuning registers (community-discovered). Uncomment to enable;
           internal_max_vel/internal_max_acc/internal_acc_coeff: [0,254], internal_control_period: [1,254].
      <param name="internal_max_vel">65</param>
      <param name="internal_max_acc">254</param>
      <param name="internal_acc_coeff">0</param>
      <param name="internal_control_period">20</param>
      -->
      <!-- cmd interfaces depend on arm_operating_mode -->
      <xacro:if value="${'$(arg arm_operating_mode)' == '2'}">
        <command_interface name="effort"/>
      </xacro:if>
      <xacro:unless value="${'$(arg arm_operating_mode)' == '2'}">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
      </xacro:unless>
      <state_interface name="position"/>
