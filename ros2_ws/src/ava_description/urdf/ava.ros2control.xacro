<?xml version="1.0"?>
<!-- ros2_control block for the Ava arm.
     This is the ONLY file that changes between sim and real hardware: the
     ros2_control_hardware_type arg (declared in ava.urdf.xacro) picks the <hardware>
     plugin. Joints, limits and the position command interface are identical for every
     backend; only the real backend gets the servo calibration params, and only the
     simulated/mock backends export an effort state (the hobby servos cannot measure it;
     tools/torque_monitor.py reads it in simulation).
     Included by ava.urdf.xacro - not a standalone robot. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="hw_type" value="$(arg ros2_control_hardware_type)"/>

  <!-- One actuated joint. Calibration values come from ava.control.xacro; zero_us (pulse at
       q = 0) is derived from the pulse at mid-range:
         zero_us = center_us - direction * (lower + upper) / 2 * servo_us_per_rad -->
  <xacro:macro name="ava_servo_joint" params="name channel direction center_us max_velocity lower upper">
    <joint name="${name}">
      <xacro:if value="${hw_type == 'real'}">
        <param name="channel">${channel}</param>
        <param name="zero_us">${center_us - direction * (lower + upper) / 2.0 * servo_us_per_rad}</param>
        <param name="us_per_rad">${servo_us_per_rad}</param>
        <param name="direction">${direction}</param>
        <param name="min_us">${servo_min_us}</param>
        <param name="max_us">${servo_max_us}</param>
        <param name="max_velocity">${max_velocity}</param>
        <param name="min_position">${lower}</param>
        <param name="max_position">${upper}</param>
      </xacro:if>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <xacro:unless value="${hw_type == 'real'}">
        <state_interface name="effort"/>
      </xacro:unless>
    </joint>
  </xacro:macro>

  <!-- ROS 2 CONTROL -->
  <ros2_control name="ava_control" type="system">
    <hardware>
      <xacro:if value="${hw_type == 'mujoco'}">
        <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
        <param name="mujoco_model">$(arg mujoco_model)</param>
        <param name="headless">$(arg mujoco_headless)</param>
      </xacro:if>
      <xacro:if value="${hw_type == 'gazebo'}">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:if value="${hw_type == 'mock_components'}">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
      <!-- ESP32 + PCA9685 over USB serial (package ava_hardware). NOTE: activation commands
           every joint to 0 rad, so the arm jumps to the home pose at start-up. -->
      <xacro:if value="${hw_type == 'real'}">
        <plugin>ava_hardware/AvaServoSystem</plugin>
        <param name="serial_port">$(arg serial_port)</param>
        <param name="baud_rate">$(arg baud_rate)</param>
        <param name="handshake_timeout_ms">${servo_handshake_timeout_ms}</param>
        <param name="release_on_deactivate">${str(servo_release_on_deactivate).lower()}</param>
      </xacro:if>
    </hardware>

    <xacro:ava_servo_joint name="shoulder_pan" channel="${shoulder_pan_channel}"
      direction="${shoulder_pan_direction}" center_us="${shoulder_pan_center_us}"
      max_velocity="${shoulder_pan_max_velocity}"
      lower="${shoulder_pan_lower}" upper="${shoulder_pan_upper}"/>
    <xacro:ava_servo_joint name="shoulder_lift" channel="${shoulder_lift_channel}"
      direction="${shoulder_lift_direction}" center_us="${shoulder_lift_center_us}"
      max_velocity="${shoulder_lift_max_velocity}"
      lower="${shoulder_lift_lower}" upper="${shoulder_lift_upper}"/>
    <xacro:ava_servo_joint name="elbow_flex" channel="${elbow_flex_channel}"
      direction="${elbow_flex_direction}" center_us="${elbow_flex_center_us}"
      max_velocity="${elbow_flex_max_velocity}"
      lower="${elbow_flex_lower}" upper="${elbow_flex_upper}"/>
    <xacro:ava_servo_joint name="wrist_flex" channel="${wrist_flex_channel}"
      direction="${wrist_flex_direction}" center_us="${wrist_flex_center_us}"
      max_velocity="${wrist_flex_max_velocity}"
      lower="${wrist_flex_lower}" upper="${wrist_flex_upper}"/>
    <xacro:ava_servo_joint name="wrist_roll" channel="${wrist_roll_channel}"
      direction="${wrist_roll_direction}" center_us="${wrist_roll_center_us}"
      max_velocity="${wrist_roll_max_velocity}"
      lower="${wrist_roll_lower}" upper="${wrist_roll_upper}"/>
    <xacro:ava_servo_joint name="gripper" channel="${gripper_channel}"
      direction="${gripper_direction}" center_us="${gripper_center_us}"
      max_velocity="${gripper_max_velocity}"
      lower="${gripper_lower}" upper="${gripper_upper}"/>
  </ros2_control>

</robot>
