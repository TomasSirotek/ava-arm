<?xml version="1.0" encoding="UTF-8"?>
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.
    A URDF file must exist for this robot as well, where the joints and the links that are referenced are defined
-->
<robot name="ava">
    <!--GROUPS: Representation of a set of joints and links. This can be useful for specifying DOF to plan for, defining arms, end effectors, etc-->
    <!--LINKS: When a link is specified, the parent joint of that link (if it exists) is automatically included-->
    <!--JOINTS: When a joint is specified, the child link of that joint (which will always exist) is automatically included-->
    <!--CHAINS: When a chain is specified, all the links along the chain (including endpoints) are included in the group. Additionally, all the joints that are parents to included links are also included. This means that joints along the chain and the parent joint of the base link are included in the group-->
    <!--SUBGROUPS: Groups can also be formed by referencing to already defined group names-->
    <group name="arm">
        <chain base_link="base_link" tip_link="end_effector_link"/>
    </group>
    <group name="gripper">
        <joint name="gripper"/>
    </group>
    <!--GROUP STATES: Purpose: Define a named state for a particular group, in terms of joint values. This is useful to define states like 'folded arms'-->
    <!--All four states below are verified in-limit and self-collision-free against the
        current CAD export. shoulder_lift's range is asymmetric (-0.21 .. 2.09), so poses
        from the old SO-101 model do not carry over.-->
    <group_state name="home" group="arm">
        <joint name="elbow_flex" value="0"/>
        <joint name="shoulder_lift" value="0"/>
        <joint name="shoulder_pan" value="0"/>
        <joint name="wrist_flex" value="0"/>
        <joint name="wrist_roll" value="0"/>
    </group_state>
    <group_state name="pose_1" group="arm">
        <joint name="elbow_flex" value="0"/>
        <joint name="shoulder_lift" value="1.0"/>
        <joint name="shoulder_pan" value="1.5"/>
        <joint name="wrist_flex" value="-1.0"/>
        <joint name="wrist_roll" value="0"/>
    </group_state>
    <group_state name="open" group="gripper">
        <joint name="gripper" value="-0.59"/>
    </group_state>
    <group_state name="closed" group="gripper">
        <joint name="gripper" value="0.19"/>
    </group_state>
    <!--END EFFECTOR: Purpose: Represent information about an end effector.-->
    <end_effector name="gripper_eef" parent_link="gripper_base_link" group="gripper" parent_group="arm"/>
    <!--VIRTUAL JOINT: Purpose: this element defines a virtual joint between a robot link and an external frame of reference (considered fixed with respect to the robot)-->
    <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base_footprint"/>
    <!--DISABLE COLLISIONS: By default it is assumed that any link of the robot could potentially come into collision with any other link in the robot. This tag disables collision checking between a specified pair of links. -->
    <!--Only the 7 structural links carry <collision> geometry (ava.kinematics.xacro strips
        it from the 38 cosmetic bearing/spacer/servo/horn links), so this matrix covers
        21 pairs. The 6 adjacent pairs below are disabled because joined links always
        touch at the joint.

        The remaining 15 pairs are deliberately LEFT ENABLED. Sampling 600 random
        configurations over the new limits shows this arm can fold onto itself -
        shoulder_link/gripper_base_link closes to 1.3 mm and upper_arm_link/
        gripper_jaw_link to 1.6 mm - so those are genuine self-collisions the planner
        must catch. The old SO-101 SRDF marked several of them "Never"; that no longer
        holds for this geometry.-->
    <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
    <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
    <disable_collisions link1="forearm_link" link2="wrist_link" reason="Adjacent"/>
    <disable_collisions link1="wrist_link" link2="gripper_base_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_base_link" link2="gripper_jaw_link" reason="Adjacent"/>
</robot>
