# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# platformio
firmware/**/.pio/

# editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# python virtualenvs (tools/)
.venv/
venv/

# Design notes, electronics, test plans and results: local only for now (the whole folder).
# Leading slash = only the top-level docs/ (dashboard/docs/ belongs to the dashboard repo).
/docs/

# secrets / local env
.env
.env.*

# AI-agent files: local only for now (instructions, agent definitions, MCP config).
# Patterns without a leading slash match in every folder.
.omp/
.claude/
.cursor/
AGENTS.md
CLAUDE.md
GEMINI.md
.cursorrules
.mcp.json
.github/copilot-instructions.md

# logs and ROS bag recordings (large)
*.log
rosbag2_*/
*.mcap
*.db3

# ---------------------------------------------------------------------------
# Arm model files - kept out of the repo, supplied locally.
# Generated from the CAD export; see ava_description/README.md.
# ---------------------------------------------------------------------------
ros2_ws/src/ava_description/meshes/*.stl
ros2_ws/src/ava_description/urdf/ava_robotic_arm.urdf
ros2_ws/src/ava_description/urdf/ava.kinematics.xacro
ros2_ws/src/ava_description/urdf/ava.urdf

# CAD sources and printable exports
hardware/stl/*
hardware/step/*
!hardware/stl/.gitkeep
!hardware/step/.gitkeep
*.f3d
*.f3z
*.step
*.stp
*.iges

